<Window x:Class="AppTimeTracker.UI.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:AppTimeTracker.UI.Converters"
        mc:Ignorable="d"
        Title="Настройки" Height="600" Width="650"
        Icon="/Resources/Icons/app.ico"
        WindowStartupLocation="CenterOwner"
        MinWidth="600" MinHeight="500"
        UseLayoutRounding="True">

    <Window.Resources>
        <converters:ProcessNameToIconConverter x:Key="ProcessNameToIconConverter"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome 
        CaptionHeight="32"
        ResizeBorderThickness="6"
        CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid Background="{StaticResource DarkBackground1}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{StaticResource WindowTitleBackground}" 
                BorderBrush="{StaticResource WindowBorder}"
                BorderThickness="0,0,0,1"
                Height="32"
                x:Name="WindowTitleBar"
                WindowChrome.IsHitTestVisibleInChrome="True"
                MouseLeftButtonDown="WindowTitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0">
                    <Image Source="/Resources/Icons/app.ico" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Настройки" 
                              VerticalAlignment="Center" 
                              Margin="8,0,0,0"
                              Foreground="{StaticResource WindowTitleForeground}"
                              FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" 
                            Content="─" 
                            Tag="Minimize"
                            Style="{StaticResource CustomWindowButtonStyle}"
                            Click="MinimizeButton_Click"
                            ToolTip="Свернуть"/>

                    <Button x:Name="MaximizeRestoreButton" 
                            Content="□" 
                            Tag="Maximize"
                            Style="{StaticResource CustomWindowButtonStyle}"
                            Click="MaximizeRestoreButton_Click"
                            ToolTip="Развернуть"/>

                    <Button x:Name="CloseButton" 
                            Content="✕" 
                            Tag="Close"
                            Style="{StaticResource CloseWindowButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Закрыть"
                            FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="20" VerticalScrollBarVisibility="Auto" Background="Transparent">
            <StackPanel Background="{StaticResource DarkBackground1}">
                <GroupBox Header="Автозагрузка" Margin="0,0,0,20">
                    <StackPanel Margin="0,5">
                        <CheckBox x:Name="StartupCheckBox" Content="Запускать при старте Windows"
                                 Margin="0,0,0,10" FontSize="14" MinHeight="30"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Текущий статус:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="14"/>
                            <TextBlock x:Name="StartupStatus" VerticalAlignment="Center"
                                      Foreground="{StaticResource AccentColor}" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Ярлык на рабочем столе" Margin="0,0,0,20">
                    <StackPanel Margin="0,5">
                        <Button Click="CreateShortcutNow_Click" 
                                MinWidth="130" MinHeight="36" FontSize="14"
                                Style="{StaticResource PrimaryButton}">
                            <TextBlock Text="Создать ярлык сейчас" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Черный список приложений" Margin="0,0,0,20">
                    <StackPanel Margin="0,5">
                        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                               Margin="0,0,0,15">
                            <ListBox x:Name="BlacklistBox" Height="180" FontSize="14">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding ., Converter={StaticResource ProcessNameToIconConverter}}" 
                                                   Width="16" Height="16" Margin="5,0,8,0"/>
                                            <TextBlock Text="{Binding .}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="ProcessCombo" Width="300" Height="36" FontSize="14" Margin="0,0,15,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding ., Converter={StaticResource ProcessNameToIconConverter}}" 
                                                   Width="16" Height="16" Margin="5,0,8,0"/>
                                            <TextBlock Text="{Binding .}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Добавить" Click="AddToBlacklist_Click" 
                                    Width="130" Height="36" FontSize="14" FontWeight="SemiBold"
                                    Background="{StaticResource AccentColor}" Foreground="White"
                                    BorderBrush="{StaticResource AccentColor}"
                                    Padding="12,0"/>
                            <Button Content="Удалить" Click="RemoveFromBlacklist_Click"
                                    Width="130" Height="36" FontSize="14" FontWeight="SemiBold"
                                    Padding="12,0"
                                    Margin="15,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Статистика" Margin="0,0,0,20">
                    <StackPanel Margin="0,5">
                        <Button Click="ClearAllStats_Click" 
                                MinWidth="130" MinHeight="36" FontSize="14"
                                Style="{StaticResource PrimaryButton}">
                            <TextBlock Text="Очистить всю статистику" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </GroupBox>

                <Border Margin="0,20,0,0" 
                        BorderBrush="{StaticResource BorderColor}" 
                        BorderThickness="0,1,0,0"
                        Padding="0,20,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" 
                                Click="Cancel_Click" 
                                Width="130" Height="36" FontSize="14" FontWeight="SemiBold"
                                Padding="12,0"
                                Margin="0,0,15,0"/>
                        <Button Content="Сохранить" 
                                Click="SaveSettings_Click" 
                                Width="130" Height="36" FontSize="14" FontWeight="SemiBold"
                                Background="{StaticResource AccentColor}" Foreground="White"
                                BorderBrush="{StaticResource AccentColor}"
                                Padding="12,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>