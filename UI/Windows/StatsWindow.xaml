<Window x:Class="AppTimeTracker.UI.Windows.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:AppTimeTracker.UI.Converters"
        mc:Ignorable="d"
        Title="Статистика" Height="650" Width="1200"
        Icon="/Resources/Icons/app.ico"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        MinWidth="1000" MinHeight="600"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
            <converters:Base64ToImageSourceConverter x:Key="Base64ToImageSourceConverter"/>

            <ContextMenu x:Key="AppListContextMenu" x:Shared="false">
                <MenuItem Header="Переименовать" Click="RenameMenuItem_Click"/>
                <MenuItem Header="Выбрать иконку" Click="SelectIconMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Добавить в черный список" Click="AddToBlacklistMenuItem_Click"/>
                <MenuItem Header="Прекратить отслеживание" Click="ExcludeFromTrackingMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Удалить запись" Click="DeleteMenuItem_Click"/>
            </ContextMenu>

            <DataTemplate x:Key="StatItemTemplate">
                <Border Padding="10,8" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" 
                               Source="{Binding IconBase64, Converter={StaticResource Base64ToImageSourceConverter}}" 
                               Width="24" Height="24" 
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Stretch="Uniform"/>

                        <TextBlock Grid.Column="1" 
                                   Text="{Binding AppName}" 
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding AppName}"/>

                        <TextBlock Grid.Column="2" 
                                   Text="{Binding Time, Converter={StaticResource TimeSpanToStringConverter}}" 
                                   VerticalAlignment="Center"
                                   MinWidth="120"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid Background="{StaticResource DarkBackground1}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{StaticResource WindowTitleBackground}" 
                BorderBrush="{StaticResource WindowBorder}"
                BorderThickness="0,0,0,1"
                Height="32"
                x:Name="WindowTitleBar"
                WindowChrome.IsHitTestVisibleInChrome="True"
                MouseLeftButtonDown="WindowTitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0">
                    <Image Source="/Resources/Icons/app.ico" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Статистика" 
                              VerticalAlignment="Center" 
                              Margin="8,0,0,0"
                              Foreground="{StaticResource WindowTitleForeground}"
                              FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" 
                            Content="─" 
                            Tag="Minimize"
                            Style="{StaticResource CustomWindowButtonStyle}"
                            Click="MinimizeButton_Click"
                            ToolTip="Свернуть"/>

                    <Button x:Name="MaximizeRestoreButton" 
                            Content="□" 
                            Tag="Maximize"
                            Style="{StaticResource CustomWindowButtonStyle}"
                            Click="MaximizeRestoreButton_Click"
                            ToolTip="Развернуть"/>

                    <Button x:Name="CloseButton" 
                            Content="✕" 
                            Tag="Close"
                            Style="{StaticResource CloseWindowButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Закрыть"
                            FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" 
                Background="{StaticResource DarkBackground2}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="14"/>
                <ComboBox x:Name="PeriodCombo"
                          ItemsSource="{Binding PeriodItems}"
                          SelectedIndex="{Binding SelectedPeriodIndex}"
                          Margin="8,0" Width="160" Height="42" FontSize="14"/>

                <DatePicker x:Name="FromDate" 
                          SelectedDate="{Binding SelectedFromDate}"
                          Margin="8,0" Width="150" Height="42" FontSize="14" 
                          IsEnabled="{Binding IsDateRangeEnabled}"/>
                <TextBlock Text="по" VerticalAlignment="Center" Margin="12,0" FontSize="14"/>
                <DatePicker x:Name="ToDate" 
                          SelectedDate="{Binding SelectedToDate}"
                          Margin="8,0" Width="150" Height="42" FontSize="14" 
                          IsEnabled="{Binding IsDateRangeEnabled}"/>

                <Separator Width="30" Background="{StaticResource BorderColor}" Margin="8,0"/>

                <TextBlock Text="Показать:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="14"/>
                <ComboBox x:Name="TopCountCombo"
                          ItemsSource="{Binding TopCountItems}"
                          SelectedIndex="{Binding SelectedTopCountIndex}"
                          Margin="8,0" Width="160" Height="42" FontSize="14"/>

                <Separator Width="30" Background="{StaticResource BorderColor}" Margin="8,0"/>

                <Button Command="{Binding UpdateStatsCommand}" Content="Обновить" Margin="8,0" 
                        MinHeight="42" FontSize="14"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ListBox x:Name="SimpleListBox"
                     ItemsSource="{Binding StatItems}"
                     ItemTemplate="{StaticResource StatItemTemplate}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLengthUnit="Item"
                     VirtualizingPanel.CacheLength="10,10"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     BorderBrush="{StaticResource BorderColor}"
                     BorderThickness="1"
                     Background="{StaticResource DarkBackground2}"
                     ContextMenu="{StaticResource AppListContextMenu}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Grid>
</Window>