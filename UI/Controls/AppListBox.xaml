<UserControl x:Class="AppTimeTracker.UI.Controls.AppListBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AppTimeTracker.UI.Controls"
             xmlns:converters="clr-namespace:AppTimeTracker.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanConverter"/>
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ListView x:Name="AppListView" ItemsSource="{Binding}" 
              Background="{StaticResource DarkBackground2}" 
              BorderBrush="{StaticResource BorderColor}"
              BorderThickness="1">
        <ListView.View>
            <GridView>
                <GridViewColumn Header="" Width="50">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Icon}" 
                                   Width="32" 
                                   Height="32"
                                   Stretch="Uniform"
                                   Margin="5,2"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <GridViewColumn Header="Приложение" Width="120">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding AppName}" 
                                       Foreground="{StaticResource TextPrimary}" 
                                       Padding="5,2"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <GridViewColumn Header="Общее время" Width="100">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TotalTime, Converter={StaticResource TimeSpanConverter}}" 
                                       Foreground="{StaticResource TextPrimary}" 
                                       Padding="5,2"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <GridViewColumn Header="Сегодня" Width="80">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DailyTime}" 
                                       Foreground="{StaticResource TextPrimary}" 
                                       Padding="5,2"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <GridViewColumn Header="Последнее" Width="80">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LastTracked, StringFormat={}{0:HH:mm}}" 
                                       Foreground="{StaticResource TextPrimary}" 
                                       Padding="5,2"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
            </GridView>
        </ListView.View>
    </ListView>
</UserControl>