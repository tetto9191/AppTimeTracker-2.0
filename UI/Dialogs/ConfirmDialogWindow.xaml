<Window x:Class="AppTimeTracker.UI.Windows.Dialogs.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AppTimeTracker"
        Height="200" Width="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}"
        BorderBrush="{StaticResource WindowBorder}"
        BorderThickness="1"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                Background="{StaticResource WindowTitleBackground}" 
                BorderBrush="{StaticResource WindowBorder}"
                BorderThickness="0,0,0,1"
                Height="32"
                WindowChrome.IsHitTestVisibleInChrome="True"
                MouseLeftButtonDown="Window_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="{Binding TitleText}" 
                          VerticalAlignment="Center" 
                          Margin="15,0"
                          Foreground="{StaticResource WindowTitleForeground}"
                          FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Сообщение -->
        <ScrollViewer Grid.Row="1" Margin="20" VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding Message}" 
                      TextWrapping="Wrap"
                      Foreground="{StaticResource TextPrimary}"
                      FontSize="14"/>
        </ScrollViewer>

        <!-- Кнопки -->
        <Border Grid.Row="2" 
                Background="{StaticResource DarkBackground2}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0"
                Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NoButton" 
                        Content="Нет" 
                        MinWidth="90" MinHeight="36"
                        Margin="0,0,10,0"
                        Click="NoButton_Click"/>
                <Button x:Name="YesButton" 
                        Content="Да" 
                        MinWidth="90" MinHeight="36"
                        Click="YesButton_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>